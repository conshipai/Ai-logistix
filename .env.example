# MConnect — environment configuration
#
# Copy to .env for local development. In production these are set in the
# Coolify application's Environment Variables panel, never in a committed file.
# Never commit real credentials.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# In Coolify, point this at the attached PostgreSQL service using its internal
# hostname — never at localhost, which does not resolve across containers.
DATABASE_URL="postgresql://mconnect:CHANGE_ME@localhost:5432/mconnect?schema=public"

# Used only by the test suite. Must be a dedicated, disposable database.
TEST_DATABASE_URL="postgresql://mconnect:CHANGE_ME@localhost:5432/mconnect_test?schema=public"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Rotating this signs every user out; it does not invalidate stored passwords.
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# The public origin. Auth.js uses it to validate callbacks; the notification
# service uses it to build links in email.
AUTH_URL="https://mconnect.ailogistix.co"
APP_URL="https://mconnect.ailogistix.co"

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# When these are absent, email degrades gracefully: notifications are still
# persisted and written to stdout, and the workflow is fully usable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="MConnect <no-reply@ailogistix.co>"

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# "s3" for any S3-compatible service (MinIO, Cloudflare R2, Backblaze B2, AWS).
# "local" writes to STORAGE_LOCAL_PATH, which must be a persistent volume.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.storage"

# Required when STORAGE_DRIVER=s3.
STORAGE_ENDPOINT=""
STORAGE_BUCKET="mconnect-documents"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-1"
# MinIO and most self-hosted services need path-style addressing; AWS does not.
STORAGE_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Maximum upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES="26214400"
# Lifetime of a signed document URL, in seconds.
SIGNED_URL_TTL_SECONDS="300"

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Set true only to start the container without applying migrations.
SKIP_MIGRATIONS="false"

# Pins one shared password across the demonstration accounts created by the
# seed script. Leave unset in production; never seed a production database.
# SEED_PASSWORD=""
