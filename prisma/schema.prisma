enum TransactionStage {
  PURCHASE_ORDER
  VERIFICATION
  FINANCING_REVIEW
  APPROVED
  FUNDED
  PROCUREMENT
  LOGISTICS
  MANUFACTURING
  DELIVERY
  BUYER_ACCEPTANCE
  PAYMENT
  REPAYMENT
  CLOSED
  CANCELLED
}

enum ProcurementItemStatus {
  PLANNED
  QUOTE_RECEIVED
  APPROVED
  ORDERED
  IN_PRODUCTION
  READY
  SHIPPED
  CUSTOMS
  DELIVERED
  CANCELLED
}

enum ShipmentMode {
  AIR
  OCEAN_FCL
  OCEAN_LCL
  ROAD
  RAIL
  COURIER
  PROJECT_CARGO
  OTHER
}

enum ShipmentMilestoneType {
