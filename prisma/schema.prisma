}

enum MilestoneType {
  FUNDING_APPROVED
  RAW_MATERIAL_ORDERED
  RAW_MATERIAL_SHIPPED
  RAW_MATERIAL_DELIVERED
  FABRICATION_STARTED
  PROGRESS_25
  PROGRESS_50
  PROGRESS_75
  INSPECTION_SCHEDULED
  INSPECTION_PASSED
  READY_FOR_DELIVERY
  DELIVERED
  BUYER_ACCEPTED
  INVOICE_SUBMITTED
