  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED_AT_ORIGIN
  EXPORT_CLEARED
  DEPARTED
  ARRIVED
  IMPORT_CLEARANCE
  CUSTOMS_RELEASED
  OUT_FOR_DELIVERY
  DELIVERED
